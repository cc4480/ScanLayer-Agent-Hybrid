# Files the secret scan skips, one repo-relative path per line, each with the reason.
# This repo is a security scanner: its detectors and their tests contain deliberately
# fake or documented-example credentials. A NEW file that trips the scan is a decision:
# remove the secret and rotate it, or add the file here with a comment saying why it is fake.

# Planted fake AWS and GitHub credentials the end-to-end detection check must find.
scripts/detection-check.ts

# Example and placeholder tokens the false-positive filters recognise and drop
# (AWS's documented example key, sk_live_ placeholders) and the tests that prove it.
server/fpFilters.ts
server/fpFilters.test.ts
server/fpSanity.test.ts
server/googleFalsePositives.test.ts

# Secret detectors: comments and tests quoting the shapes they look for.
server/staticAnalysis.ts
server/staticAnalysis.test.ts
