{
  "name": "dsh-machine-control",
  "version": "0.1.0",
  "private": true,
  "description": "Local machine administration for DSH: sidebar entries plus agent tools for shell, processes, services, startup items, system information, network, security posture, packages and disk.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-layout": "link:../deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:../deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-shell": "link:../deepseek-harness/packages/shell/shell",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
