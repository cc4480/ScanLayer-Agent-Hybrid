{
  "name": "dsh-qnx",
  "version": "0.1.0",
  "private": true,
  "description": "The DeepSeek Harness built for a QNX 8.0 target: sidebar pages (target with live gate tape, scan and verify, scope and proof) and two Code Mode agent tools, qnx_search and qnx_execute, behind a pre-spawn scope gate with a hash-chained audit log.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "engine",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "build:runner": "make -C engine/node-runtime",
    "test": "make -sC engine/node-runtime && node --test engine/test/*.test.js",
    "prove": "node engine/scripts/prove.js engine/standin/config.json engine/docs/receipts"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-layout": "link:../deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:../deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-sandbox": "link:../deepseek-harness/packages/sandbox/sandbox",
    "@deepseek-ai/dsh-shell": "link:../deepseek-harness/packages/shell/shell",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
